{
  "name": "repairflow",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/*\" dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "depcruise": "pnpm --filter api depcruise",
    "test": "pnpm --filter @repairflow/contracts build && pnpm -r test",
    "test:e2e": "pnpm --filter @repairflow/contracts build && pnpm --filter api test:e2e",
    "test:playwright": "pnpm --filter web test:playwright",
    "openapi": "pnpm --filter @repairflow/contracts openapi"
  }
}
