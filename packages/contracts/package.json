    "prepare": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zod-openapi": "^6.0.2"
  }
}
