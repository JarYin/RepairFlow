# Copy to .env for local development. Never commit real values.
# Production values live in the GitHub Environment `production` and in Vercel.

# API: connection used at runtime with the app_tenant role (Neon pooler in production)
# With `pnpm db:up` locally: postgres://app_tenant@127.0.0.1:5432/repairflow
DATABASE_URL=

# Direct (non-pooler) connection with the Migration role, used only to migrate.
# Leave empty to migrate the local Postgres from `pnpm db:up`.
MIGRATION_DATABASE_URL=

# Web: origin of the API that next.config.ts rewrites /api/* to, read at build time.
# Required by `next build`. `next dev` falls back to http://localhost:4000.
# Next.js does not read the .env at the repo root: set this in apps/web/.env or the shell.
API_ORIGIN=

# Smoke test: origin of the running Web that `pnpm test:smoke` checks. No default on purpose.
SMOKE_BASE_URL=

# API: spike module, removed before Sprint 1 ends. Routes exist only when the flag is set.
SPIKE_ENABLED=
SPIKE_SECRET=

# API: Vercel Blob store used by the private Blob experiment
BLOB_READ_WRITE_TOKEN=
