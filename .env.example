# Copy to .env for local development. Never commit real values.
# Production values live in the GitHub Environment `production` and in Vercel.

# API: connection used at runtime with the app_tenant role (Neon pooler in production)
DATABASE_URL=

# CI/local: direct (non-pooler) connection with the Migration role, used only to migrate
MIGRATION_DATABASE_URL=

# Web: production domain of the API that next.config.ts rewrites /api/* to
API_ORIGIN=

# API: spike module, removed before Sprint 1 ends. Routes exist only when the flag is set.
SPIKE_ENABLED=
SPIKE_SECRET=

# API: Vercel Blob store used by the private Blob experiment
BLOB_READ_WRITE_TOKEN=
